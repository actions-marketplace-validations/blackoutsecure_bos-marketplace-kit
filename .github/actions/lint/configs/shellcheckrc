# Packaged default shellcheck config shipped with the
# bos-marketplace-kit `lint` composite action. Used automatically (via
# `shellcheck --rcfile=...`) when the consumer repo does NOT define
# its own `.shellcheckrc` at the repo root. To override, drop a
# `.shellcheckrc` in the consumer repo root — the composite detects it
# and lets shellcheck's normal upward search resolve it.
#
# Composite action `run:` blocks are invoked by GitHub Actions runners
# with bash, so we tell shellcheck to assume that interpreter regardless
# of any missing shebang in extracted snippets.
#
# Disabled checks:
#   SC2016 — Expressions don't expand in single quotes. We deliberately
#            single-quote ${{ github.* }} so the runner expands them, not
#            the shell. Disabling avoids false positives across all the
#            composites.
#   SC1091 — Not following sourced file. Composites source helpers from
#            relative paths that shellcheck can't resolve at lint time
#            outside the action's runtime cwd.

shell=bash
disable=SC2016,SC1091
external-sources=true
