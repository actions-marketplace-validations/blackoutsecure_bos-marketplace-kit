{
  "marketplace": {
    "enabled": true,
    "target_branch": "main",
    "allowlist_paths": [
      "action.yml",
      ".github/actions",
      "src",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "blocked_paths": [
      ".github/workflows/",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".markdownlint.json",
      ".markdownlint.yaml",
      ".shellcheckrc",
      ".yamllint.yml",
      "pyproject.toml",
      "scripts/",
      "test/"
    ],
    "required_paths": [
      ".github/dependabot.yml",
      "action.yml",
      ".github/actions",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "include_dependabot_config": true,
    "include_github_metadata": false,
    "repo_metadata": {
      "enable": true,
      "homepage": "https://github.com/marketplace/actions/blackout-secure-marketplace-kit",
      "generate_topics": true,
      "topics_fallback": "github-actions marketplace composite-action ci-cd release-management devsecops publishing"
    }
  },
  "marketplace_kit": {
    "use_marketplace_config": true,
    "defer_to_code_scanning_kit": true
  },
  "managed_file_sync": {
    "use_marketplace_config": true,
    "services": [
      "common",
      "lf_line_endings",
      "dependabot_actions",
      "dependabot_pip",
      "editorconfig",
      "bos_universal_marketplace_kicker",
      "bos_universal_action_test_kicker"
    ]
  },
  "action_test": {
    "python_versions": [
      "3.10",
      "3.11",
      "3.12"
    ],
    "python_packages": [
      ".[dev]"
    ]
  }
}
